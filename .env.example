# --- Database (Supabase Postgres) ---
# From Supabase: Project Settings -> Database
# Pooled connection (port 6543), used by the app at runtime — use a
# least-privilege role scoped to this app's own tables (see
# prisma/migrations/*_create_least_privilege_app_role), not the default
# `postgres` owner role.
DATABASE_URL="postgresql://ai_laundry_app:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (port 5432), used only by `prisma migrate` / `db seed` —
# needs the owner role's schema-altering privileges.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Admin session signing ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- First admin bootstrap (used once by `npm run db:seed`) ---
ADMIN_EMAIL="admin@ailaundrybasket.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# --- Resend email ---
# Note: EMAIL_FROM requires a domain verified in Resend — a gmail.com address
# will not work here. BUSINESS_NOTIFICATION_EMAIL (where new leads/orders are
# sent) can be any real inbox, e.g. the business's laundrybasketai@gmail.com.
RESEND_API_KEY=""
EMAIL_FROM="A&I Laundry Basket <no-reply@ailaundrybasket.com>"
BUSINESS_NOTIFICATION_EMAIL="laundrybasketai@gmail.com"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
